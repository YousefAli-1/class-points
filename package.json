{
  "name": "class-points",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run -c vitest.config.ts",
    "test:worker": "vitest run -c vitest.workers.config.ts",
    "test:all": "npm run test && npm run test:worker",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed:local": "node scripts/seed.ts",
    "restore:backup": "node scripts/restore-backup.ts",
    "icons": "node scripts/make-icons.ts",
    "cf-typegen": "wrangler types",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "canvas-confetti": "1.9.4",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.13",
    "motion": "12.43.0",
    "radix-ui": "1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "react-router": "7.18.4",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/canvas-confetti": "1.9.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  },
  "overrides": {
    "@cloudflare/vitest-pool-workers": {
      "miniflare": "5.20261006.1-alpha",
      "wrangler": "$wrangler"
    }
  }
}
